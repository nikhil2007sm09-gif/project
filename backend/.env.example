PORT=5000
MONGODB_URI=mongodb://localhost:27017/clothesshop
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Razorpay Configuration
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# For testing, you can use Razorpay test mode keys
# Test mode keys start with: rzp_test_
# Live mode keys start with: rzp_live_

# Email Configuration (Optional - for sending emails)
# For Gmail: Use App Password (not regular password)
# Enable 2FA and generate App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# SMS Gateway Configuration (Choose one)
# Fast2SMS (India - Recommended, Cheapest)
# Get API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_api_key_here

# OR MSG91 (India)
# MSG91_AUTH_KEY=your_auth_key_here
# MSG91_TEMPLATE_ID=your_template_id_here

# OR Twilio (International)
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890
